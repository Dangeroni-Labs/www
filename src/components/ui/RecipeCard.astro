---
import type { Recipe } from '$/lib/relicforged'
import '$/styles/components/mod-wiki.css'

interface Props {
	recipe: Recipe
}

const { recipe } = Astro.props
---

<section class="wiki-recipe" aria-label={recipe.title}>
	<h2>{recipe.title}</h2>
	<p>{recipe.description}</p>
	{
		recipe.pattern ? (
			<>
				<div class="wiki-recipe__grid" aria-label={`${recipe.title} crafting grid`}>
					{recipe.pattern.flatMap(row =>
						[...row].map(symbol => (
							<span class="wiki-recipe__cell" aria-label={recipe.key?.[symbol] ?? 'Empty slot'}>
								{symbol.trim() || ' '}
								</span>
							)),
						)}
				</div>
				<dl class="wiki-recipe__key">
					{Object.entries(recipe.key ?? {}).map(([symbol, ingredient]) => (
						<div><dt>{symbol}</dt><dd>{ingredient}</dd></div>
					))}
				</dl>
			</>
		) : (
			<p class="wiki-recipe__ingredients">{recipe.ingredients.join(' + ')} → {recipe.title}</p>
		)
	}
</section>
