---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'

interface Props {
	href: string
	logo: ImageMetadata
	logoAlt: string
	metadata: string
	summary: string
	title: string
}

const { href, logo, logoAlt, metadata, summary, title } = Astro.props
---

<a class="mod-card" href={href}>
	<Image alt={logoAlt} class="mod-card__logo" src={logo} />
	<span class="mod-card__content">
		<span class="mod-card__title">{title}</span>
		<span class="mod-card__summary">{summary}</span>
		<span class="mod-card__metadata">{metadata}</span>
	</span>
	<Icon aria-hidden="true" class="mod-card__arrow" name="mdi:arrow-right" />
</a>
