---
import '$/styles/components/mod-wiki.css'

interface Props {
	src?: string
	alt: string
	title?: string
	empty?: boolean
}

const { src, alt, title, empty = false } = Astro.props
---

<span
	class:list={['wiki-recipe__slot', { 'wiki-recipe__slot--empty': empty }]}
	title={!empty ? title ?? alt : undefined}
	aria-hidden={empty ? 'true' : undefined}
>
	{!empty && (src ? <img src={src} alt={alt} loading="lazy" width="16" height="16" /> : <span role="img" aria-label={alt}>?</span>)}
</span>
