---
import ThemeSwitch from '$/components/shared/ThemeSwitch.astro'
import Container from '$/components/ui/Container.astro'
import { PRIMARY_NAVIGATION } from '$/const/navigation'
import { SITE } from '$/const/site'
---

<header class="site-header">
	<Container class="site-header__inner">
		<a aria-label={SITE.name} class="site-header__brand" href="/">
			<span aria-hidden="true" class="site-header__brand-compact">DL</span>
			<span aria-hidden="true" class="site-header__brand-full">{SITE.shortName}</span>
		</a>
		<nav aria-label={SITE.name}>
			<ul class="site-header__links">
				{
					PRIMARY_NAVIGATION.map(item => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
				<li>
					<ThemeSwitch />
				</li>
			</ul>
		</nav>
	</Container>
</header>

<script>
	import '$/scripts/theme-switch'
</script>
