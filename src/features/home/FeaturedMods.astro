---
import Container from '$/components/ui/Container.astro'
import { HOME_CONTENT } from '$/const/content'
import ModList from '$/features/mods/ModList.astro'
import type { ModEntry } from '$/lib/mods'

interface Props {
	mods: ModEntry[]
}

const { mods } = Astro.props
---

<section class="featured-mods" aria-labelledby="featured-mods-title">
	<Container>
		<div class="section-heading">
			<p class="section-eyebrow">{HOME_CONTENT.featured.eyebrow}</p>
			<h2 id="featured-mods-title">{HOME_CONTENT.featured.title}</h2>
		</div>
		<ModList mods={mods} />
		<a class="text-link" href="/mods">{HOME_CONTENT.featured.action}</a>
	</Container>
</section>
